{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/userDataFunction/definition/1.1.0/schema.json",
  "runtime": "PYTHON",
  "connectedDataSources": [
    {
      "alias": "githubConfig",
      "artifactId": "<GITHUB_CONFIG_ITEM_ID>",
      "artifactType": "Variables",
      "workspaceId": "<APP_WORKSPACE_ID>"
    },
    {
      "alias": "sqlDB",
      "artifactId": "<APP_SQL_DATABASE_ITEM_ID>",
      "artifactType": "SqlDbNative",
      "workspaceId": "<APP_WORKSPACE_ID>"
    }
  ],
  "functions": [
    {
      "name": "commit_change_set",
      "description": "",
      "isPublicEndpointEnabled": true
    },
    {
      "name": "log_recommendation",
      "description": "",
      "isPublicEndpointEnabled": true
    }
  ],
  "libraries": {
    "public": [
      {
        "name": "fabric-user-data-functions",
        "type": "PYPI",
        "version": "1.0"
      },
      {
        "name": "jsonpatch",
        "type": "PYPI",
        "version": "1.36"
      },
      {
        "name": "requests",
        "type": "PYPI",
        "version": "2.34.2"
      }
    ],
    "private": []
  }
}
